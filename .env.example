# ============================================================
# Car Reviews NLP Pipeline - Environment Variables
# Copy this file to .env and fill in the values as needed.
# ============================================================

# -- HuggingFace / Model Cache --
# Directory where HuggingFace stores downloaded models (default: ~/.cache/huggingface)
HF_HOME=

# -- Project Directories --
# All paths are relative to the project root.
DATASET_DIR=dataset
RESULTS_DIR=results
MODELS_DIR=models
CACHE_DIR=.cache

# -- Dataset Files --
DATASET_FILE=car_reviews.csv
REFERENCE_FILE=reference_translations.txt

# -- Model Selection --
# Override default models for each NLP task.
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
TRANSLATION_MODEL=Helsinki-NLP/opus-mt-en-es
SUMMARIZATION_MODEL=cnicu/t5-small-booksum
QA_MODEL=deepset/minilm-uncased-squad2
TOPIC_MODEL=all-MiniLM-L6-v2
ASPECT_MODEL=yangheng/deberta-v3-base-absa-v1.1

# -- Performance --
BATCH_SIZE=8
MAX_LENGTH=512
NUM_WORKERS=2
ENABLE_MODEL_CACHE=true
# Fraction of system memory at which to stop loading new models (0.0-1.0)
MEMORY_THRESHOLD=0.8

# -- Topic Modeling --
MIN_TOPIC_SIZE=2
NUM_TOPICS=5

# -- Visualization --
FIG_WIDTH=10
FIG_HEIGHT=6
DPI=100
COLOR_PALETTE=viridis

# -- Logging --
LOG_LEVEL=INFO
LOG_FILE=car_reviews_analysis.log

# -- Export --
# Comma-separated list of export formats: json, csv, excel
EXPORT_FORMATS=json,csv,excel
SAVE_PLOTS=true

# -- Docker / Runtime --
# These are set automatically in the Dockerfile but can be overridden.
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
TOKENIZERS_PARALLELISM=false
